<Window x:Class="Labs_WPF.SortingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Сортировки" Height="550" Width="960" WindowStartupLocation="CenterScreen"
        MinHeight="550" MinWidth="960">

    <Grid>
        <Menu VerticalAlignment="Top" FontSize="16">
            <Button x:Name="manualInputBtn" Content="Ручной ввод" IsEnabled="False"></Button>
            <Button x:Name="SortBtn" Content="Сортировать" ></Button>
            <Button x:Name="ClearBtn" Content="Очистить" ></Button>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>


            <Viewbox VerticalAlignment="Top">
                <StackPanel Grid.Column="0" Margin="10">
                    <GroupBox Header="Сортировки" Margin="0,10,0,10">
                        <StackPanel>
                            <CheckBox x:Name="bubbleSortCB" Content="Пузырьковая" IsChecked="True"/>
                            <CheckBox x:Name="insertSortCB" Content="Вставками" IsChecked="True"/>
                            <CheckBox x:Name="quickSortCB" Content="Быстрая" IsChecked="True"/>
                            <CheckBox x:Name="shakerSortCB" Content="Шейкерная" IsChecked="True"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="bogoSortCB" Content="Болотная" IsChecked="True" Click="bogoSortCB_Click"/>
                                <TextBlock Margin="44,0,5,0">Макс. итераций:</TextBlock>
                                <TextBox x:Name="bogoSortIterationsTB" Width="75" Text="100"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Тип ввода" Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton GroupName="InputType" x:Name="manualInputRB" Content="Ручной" Margin="0,0,0,5" Checked="manualInputRB_Checked"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" >
                                <RadioButton GroupName="InputType" x:Name="generateRB" Content="Генерация" IsChecked="True" Click="generateRB_Click"/>
                                <TextBlock Margin="61,0,5,0">Количество:</TextBlock>
                                <TextBox x:Name="generateElementsNumberTB" Width="75" Text="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="InputType" x:Name="fileInputRB" Content="Из файла" Click="fileInputRB_Click"/>
                                <Button x:Name="chooseFileBtn" Content="Выбрать файл" Margin="134,0,0,0" IsEnabled="False" Click="chooseFileBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Column="0" Margin="0,0,0,10" HorizontalAlignment="Left">
                        <TextBlock>Минимальное число для генерации:</TextBlock>
                        <TextBox x:Name="minNumberTB" Width="100" Text="-10" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        <TextBlock>Максимальное число:</TextBlock>
                        <TextBox x:Name="maxNumberTB" Width="100" Text="10" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <GroupBox Header="Сортировать по">
                        <StackPanel>
                            <RadioButton x:Name="ascendingSortRB" Content="Возрастанию" IsChecked="True" Margin="0,0,0,5"/>
                            <RadioButton x:Name="descendingSortRB" Content="Убыванию"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Viewbox>

            <Grid Grid.Column="1">
                <Viewbox VerticalAlignment="Top">
                    <Grid Grid.Column="1">
                        <GroupBox Header="Таблица результатов" Margin="0,13,5,0">
                            <DataGrid x:Name="resultGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="175">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="Method"  Header="Метод"/>
                                    <DataGridTextColumn x:Name="Array"  Header="Массив"/>
                                    <DataGridTextColumn x:Name="Iterations" Header="Итерации"/>
                                    <DataGridTextColumn x:Name="Time" Header="Время"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</Window>
