<Window x:Class="Labs_WPF.IntegralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Интеграл"
        Height="540" Width="960"
        MinHeight="540" MinWidth="960">
    <Grid>
        <Menu VerticalAlignment="Top" FontSize="16">
            <Button x:Name="plotBtn" Content="Построить" Click="plotBtn_Click"/>
            <Button x:Name="calculateBtn" Content="Расчитать" Click="calculateBtn_Click"/>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Margin="5,15,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Введите интеграл:" Margin="0,10,0,5"/>
                    <StackPanel>
                        <TextBox x:Name="upperLimitTB" Text="10" Width="48" HorizontalAlignment="Left" TextChanged="integralTB_TextChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                            <TextBlock Text="∫" VerticalAlignment="Center"/>
                            <TextBox x:Name="integralTB" Text="x" Margin="5,0,5,0" Width="228" TextChanged="integralTB_TextChanged"/>
                            <TextBlock Text="dx" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="lowerLimitTB" Text="-10" Width="48" TextChanged="integralTB_TextChanged" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                        <GroupBox Header="Методы" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="rectangleMethodCB" Content="Прямогольников" IsChecked="True"/>
                                    <RadioButton x:Name="rectangleVisualizationCB" GroupName="Visualization" Content="Визуализировать" IsChecked="True" Margin="5,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="trapezoidMethodCB" Content="Трапеций" IsChecked="True"/>
                                    <RadioButton x:Name="trapezoidVisualizationCB" GroupName="Visualization" Content="Визуализировать" IsChecked="False" Margin="46,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="simpsonMethodCB" Content="Симпсона" IsChecked="True"/>
                                    <RadioButton x:Name="simpsonVisualizationCB" GroupName="Visualization" Content="Визуализировать" IsChecked="False" Margin="44,0,0,0" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Кол-во разбиений:" VerticalAlignment="Center"/>
                            <TextBox x:Name="partitionsCountTB" Text="10" Margin="5,0" Width="48"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Кол-во знаков после запятой:" VerticalAlignment="Center"/>
                            <TextBox x:Name="tbE" Text="3" Margin="5,0" Width="36"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
            <Viewbox Grid.Column="1">
                <oxy:PlotView x:Name="graph" Width="550" Height="500"/>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
