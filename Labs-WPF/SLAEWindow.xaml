<Window x:Class="Labs_WPF.SLAEWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="СЛАУ"
        Height="410" Width="900"
        MinHeight="410" MinWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <StackPanel Orientation="Horizontal">
                <Label Content="Размер матрицы (N):"/>
                <TextBox Name="tbMatrixSize" Text="2" Width="65" Margin="5,0,0,0" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                <Button Name="btnSetSize" Content="Применить" Margin="10,0,0,0" Padding="5,0,5,0" VerticalAlignment="Center" Click="btnSetSize_Click"/>
            </StackPanel>

            <GroupBox Header="Методы" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox x:Name="cbGauss" Content="Метод Гаусса" IsChecked="True"/>
                    <CheckBox x:Name="cbGaussJordan" Content="Метод Гаусса-Жордана" IsChecked="True"/>
                    <CheckBox x:Name="cbCramer" Content="Метод Крамера" IsChecked="True"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Тип ввода" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton GroupName="InputType" x:Name="rbManualInput" Content="Ручной" VerticalAlignment="Center" Margin="0,5" IsChecked="True"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                            <RadioButton GroupName="InputType" x:Name="rbGenerate" Content="Генерация" VerticalAlignment="Center" Checked="rbGenerate_Checked" Unchecked="rbGenerate_Unchecked"/>
                            <Button x:Name="btnGenerate" Content="Сгенерировать" Padding="5,0,5,0" Margin="100,0,0,0" IsEnabled="False" Click="btnGenerate_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="20,5,0,5" VerticalAlignment="Center">
                            <RadioButton x:Name="rbInt" Content="Целые" IsChecked="True" IsEnabled="False"/>
                            <RadioButton x:Name="rbDouble" Content="Дробные" Margin="10,0,0,0" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Margin="20,0,0,10" HorizontalAlignment="Left">
                            <TextBlock>Минимальное число:</TextBlock>
                            <TextBox x:Name="tbMinNumber" Width="65" Text="-100" HorizontalAlignment="Left" Margin="0,0,0,5" IsEnabled="False"/>
                            <TextBlock>Максимальное число:</TextBlock>
                            <TextBox x:Name="tbMaxNumber" Width="65" Text="100" HorizontalAlignment="Left" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton GroupName="InputType" x:Name="rbFileInput" Content="Из файла" VerticalAlignment="Center" Checked="rbFileInput_Checked" Unchecked="rbFileInput_Unchecked"/>
                        <Button x:Name="btnChooseFile" Content="Выбрать файл" Padding="5,0,5,0" Margin="112,0,0,0" IsEnabled="False" Click="btnChooseFile_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <Button Name="btnSolve" Content="Вычислить" Margin="0,10,0,0" Height="25" Click="btnSolve_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <DataGrid Name="dgMatrixA" Grid.Column="0" Margin="5" AutoGenerateColumns="True" CanUserAddRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" HorizontalAlignment="Stretch" VerticalAlignment="Top"  MaxHeight="800"/>
                <DataGrid Name="dgVectorB" Grid.Column="1" Margin="5" AutoGenerateColumns="True" CanUserAddRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxHeight="800"/>
                <DataGrid Name="dgVectorGauss" Grid.Column="2" Margin="5" AutoGenerateColumns="True" CanUserAddRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxHeight="800"/>
                <DataGrid Name="dgVectorGaussJordan" Grid.Column="3" Margin="5" AutoGenerateColumns="True" CanUserAddRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxHeight="800"/>
                <DataGrid Name="dgVectorCramer" Grid.Column="4" Margin="5" AutoGenerateColumns="True" CanUserAddRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxHeight="800"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>